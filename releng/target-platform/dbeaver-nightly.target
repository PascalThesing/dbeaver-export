<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Resolves against a locally built DBeaver main repository.
     Pass -Ddbeaver.repo.url=file:///path/to/dbeaver/product/community/target/repository -->
<target name="dbeaver-nightly" sequenceNumber="2">
    <locations>
        <location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="false" type="InstallableUnit">
            <repository location="${system_property:dbeaver.repo.url}"/>
            <unit id="org.jkiss.dbeaver.model" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.model.sql" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.data.transfer" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.ext.postgresql" version="0.0.0"/>
            <unit id="com.google.gson" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.core" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.ui" version="0.0.0"/>
            <unit id="org.jkiss.dbeaver.ui.app.eclipse" version="0.0.0"/>
        </location>
        <location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="false" type="InstallableUnit">
            <repository location="https://download.eclipse.org/eclipse/updates/4.40/"/>
            <unit id="org.eclipse.core.runtime" version="0.0.0"/>
            <unit id="org.eclipse.ui.ide.application" version="0.0.0"/>
            <unit id="org.eclipse.equinox.registry" version="0.0.0"/>
            <unit id="org.eclipse.equinox.common" version="0.0.0"/>
            <unit id="org.eclipse.core.jobs" version="0.0.0"/>
            <unit id="org.eclipse.text" version="0.0.0"/>
            <unit id="org.eclipse.core.resources" version="0.0.0"/>
            <unit id="org.eclipse.core.expressions" version="0.0.0"/>
            <unit id="junit-jupiter-api" version="5.14.4"/>
            <unit id="org.eclipse.equinox.launcher" version="0.0.0"/>
            <unit id="org.apache.felix.scr" version="0.0.0"/>
            <unit id="org.junit" version="0.0.0"/>
        </location>
        <location includeDependencyDepth="none" includeSource="false" missingManifest="error" type="Maven">
            <dependencies>
                <dependency>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                    <version>33.4.8-jre</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>com.google.guava</groupId>
                    <artifactId>failureaccess</artifactId>
                    <version>1.0.3</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>commons-codec</groupId>
                    <artifactId>commons-codec</artifactId>
                    <version>1.18.0</version>
                    <type>jar</type>
                </dependency>
            </dependencies>
        </location>
    </locations>
</target>
