<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.jkiss.dbeaver.sqlCommand">
        <command
            id="exportnow"
            class="org.jkiss.dbeaver.ext.exportnow.SQLCommandExportNow"
            label="Export now"
            description="Headless export of the next query. Runs in the background without the data transfer wizard, so multiple exports in one script all execute."/>
        <pragma id="exportnow" class="org.jkiss.dbeaver.ext.exportnow.SQLPragmaExportNow"/>
    </extension>

    <extension point="org.jkiss.dbeaver.notifications">
        <notification id="exportnow.armed" name="Headless export armed"/>
        <notification id="exportnow.ok" name="Headless export finished"/>
        <notification id="exportnow.error" name="Headless export failed"/>
    </extension>
</plugin>
